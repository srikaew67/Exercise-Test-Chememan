// Prisma schema สำหรับ Employee Management System
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(USER)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // ความสัมพันธ์: employee ที่ user คนนี้เป็นคนสร้าง/อัปเดตล่าสุด
  createdEmployees Employee[] @relation("EmployeeCreatedBy")
  updatedEmployees Employee[] @relation("EmployeeUpdatedBy")

  @@map("users")
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  employees Employee[]

  @@map("departments")
}

model Employee {
  id               String         @id @default(uuid())
  // ID จากไฟล์ Excel ต้นฉบับ แยกจาก internal id เพื่อรองรับ re-import
  empCode          String         @unique @map("emp_code")
  name             String
  departmentId     String         @map("department_id")
  department       Department     @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  salary           Decimal        @db.Decimal(12, 2)
  joinDate         DateTime       @map("join_date") @db.Date
  status           EmployeeStatus @default(ACTIVE)
  lastUpdatedDate  DateTime       @default(now()) @map("last_updated_date")

  createdById      String?        @map("created_by")
  createdBy        User?          @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById      String?        @map("updated_by")
  updatedBy        User?          @relation("EmployeeUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  // Index สำหรับ search/filter ที่ใช้บ่อย
  @@index([departmentId])
  @@index([status])
  @@index([name])
  @@map("employees")
}
